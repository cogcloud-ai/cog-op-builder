{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "opportunity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^OPP-[0-9]{3}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "id",
        "title",
        "description"
      ]
    },
    "company": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      },
      "required": [
        "name",
        "capabilities"
      ]
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pursue_at": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "review_at": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "pursue_at",
        "review_at"
      ]
    }
  },
  "required": [
    "opportunity",
    "company",
    "policy"
  ]
}
