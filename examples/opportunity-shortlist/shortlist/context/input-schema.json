{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "opportunities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^OPP-[0-9]{3}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "id",
          "title",
          "description"
        ]
      }
    },
    "assessments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "decision": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "opportunity_id": {
                "type": "string",
                "pattern": "^OPP-[0-9]{3}$"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "recommendation": {
                "enum": [
                  "pursue",
                  "review",
                  "pass"
                ]
              },
              "score": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "reasons": {
                "type": "array",
                "minItems": 3,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              }
            },
            "required": [
              "opportunity_id",
              "title",
              "recommendation",
              "score",
              "reasons"
            ]
          },
          "answers": {
            "type": "object"
          },
          "answered_by": {
            "type": "object"
          }
        },
        "required": [
          "decision",
          "answers",
          "answered_by"
        ]
      }
    }
  },
  "required": [
    "opportunities",
    "assessments"
  ]
}
