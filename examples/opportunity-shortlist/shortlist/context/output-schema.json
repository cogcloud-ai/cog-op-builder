              }
            },
            "required": [
              "opportunity_id",
              "title",
              "recommendation",
              "score",
              "reasons"
            ]
          },
          "target_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "content_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "change_id",
          "summary",
          "opportunity",
          "assessment",
          "target_sha256",
          "content_sha256"
        ]
      }
    },
    "authority_use": {
      "type": "array",
      "maxItems": 0
    }
  },
  "required": [
    "ranked",
    "changes",
    "authority_use"
  ]
